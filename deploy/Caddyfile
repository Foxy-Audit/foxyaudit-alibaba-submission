# ⚠ THIS FILE DOES NOT SERVE PRODUCTION. deploy/nginx-foxyaudit.conf does.
# The `caddy` service in docker-compose.prod.yml sits behind `profiles: ["edge"]`
# and is not started on the shared VM, which already runs its own nginx on
# 80/443 (`Server: nginx/1.28.0`). This file is the dedicated-box path.
#
# It is kept BYTE-FOR-BEHAVIOUR in step with the nginx config anyway: when a
# site changes it changes in both, or the two disagree about what is public and
# whichever one you happen to read is a coin flip. That drift is not
# hypothetical — this file's /.well-known/security.txt rewrite was written,
# reviewed and marked delivered while the config production actually reads had
# no such route at all, so RFC 9116 discovery was broken for the entire time it
# was believed fixed.
#
# foxyaudit.tech — four sites, one backend. Caddy auto-provisions Let's Encrypt
# certificates for every hostname below (DNS must already point at this VM).
# Caddy ignores client-supplied X-Forwarded-For (no trusted_proxies configured),
# so the backend always sees the real client IP.

# Site 1 — marketing (static) + installer downloads
foxyaudit.tech, www.foxyaudit.tech {
	encode gzip
	# Installer binaries live outside the repo; mount them at /srv/downloads
	# (see the caddy service volume in docker-compose.prod.yml). The release
	# workflow scp's builds to the host dir.
	handle_path /download/* {
		root * /srv/downloads
		file_server
	}
	# RFC 9116. The canonical URL has to be /.well-known/security.txt, but the
	# file is committed as foxy-sale-page/security.txt with no leading dot and
	# rewritten here — so serving it does not depend on whether file_server
	# hands out dotfiles, which is behaviour we would be relying on rather than
	# stating. Content-Type is pinned because the RFC requires text/plain.
	# Ahead of the catch-all handle below, which is ordered.
	handle /.well-known/security.txt {
		rewrite * /security.txt
		root * /srv/sale
		file_server
		header Content-Type "text/plain; charset=utf-8"
	}
	handle {
		root * /srv/sale
		# Extensionless URLs resolve to the flat *.html pages, matching
		# `try_files $uri $uri.html $uri/ =404` on the nginx side. Caddy's
		# file_server already 404s an unknown path — it has never had the SPA
		# fallback to /index.html that nginx did — so only the .html step was
		# missing for the two edges to behave alike.
		try_files {path} {path}.html {path}/
		file_server
	}
}

# Site 2 — customer dashboard (backend, same-origin session cookie)
app.foxyaudit.tech {
	encode gzip
	redir / /dashboard 302
	# the staff surface is never reachable via the customer hostname
	@admin path /admin*
	respond @admin 404
	reverse_proxy foxy-backend:8000
}

# Site 3 — staff ops console (backend, /admin only)
admin.foxyaudit.tech {
	encode gzip
	redir / /admin/ 302
	# nothing but the staff surface is served on the admin hostname
	@notadmin not path /admin*
	respond @notadmin 404
	reverse_proxy foxy-backend:8000
}

# Site 4 — Paddle checkout (static). NO reverse_proxy: this page talks to Paddle
# and never to our backend, so the origin that runs third-party payment script
# has no route to the API at all.
#
# It is a separate hostname on purpose. Paddle.js has to be loaded from Paddle's
# CDN, and every other surface in this product is deliberately CDN-free; giving
# the checkout its own origin means that allowance is scoped to this block and
# the marketing site, dashboard and admin console keep their own policies
# untouched.
checkout.foxyaudit.tech {
	encode gzip
	root * /srv/checkout
	file_server

	header {
		# The ONLY third-party origin allowed anywhere in this policy is Paddle.
		#   script-src   cdn.paddle.com — Paddle.js itself. 'unsafe-inline' is
		#                allowed because this policy cannot be verified against a
		#                live Paddle checkout from here, and a CSP that silently
		#                blocks the SDK would break the only page that can take
		#                money. Our own code is external ('self') and the page's
		#                single input (_ptxn) is regex-validated and written with
		#                textContent, so there is no injection sink for inline
		#                script to be reached through. Tighten once a real
		#                sandbox checkout has been observed.
		#   frame-src    Paddle renders the actual card form in its own iframe.
		#   connect-src  Paddle.js calls its API from the page.
		#   form-action  'none' — this page posts no form anywhere, ever.
		Content-Security-Policy "default-src 'none'; script-src 'self' https://cdn.paddle.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.paddle.com; font-src 'self' data:; frame-src https://*.paddle.com https://paddle.com; connect-src https://*.paddle.com https://paddle.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# This page is a payment step, not a landing page. Keeping it out of
		# search stops expired _ptxn links being indexed and followed later.
		X-Robots-Tag "noindex, nofollow"
	}
}
